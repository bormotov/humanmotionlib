{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanmotionlib.example/schema/common.schema.json",
  "$defs": {
    "number": {
      "type": "number",
      "minimum": -1e+100,
      "maximum": 1e+100
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1e+100,
        "maximum": 1e+100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1e+100,
        "maximum": 1e+100
      },
      "minItems": 4,
      "maxItems": 4
    },
    "matrix3": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -1e+100,
          "maximum": 1e+100
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "enum": [
        "pelvis",
        "torso",
        "head_neck",
        "arm_L",
        "arm_R",
        "leg_L",
        "leg_R"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "authored",
            "adapted"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "material",
              "locator"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "license",
        "sources",
        "rationale",
        "changes"
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1e+100,
            "maximum": 1e+100
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "$ref": "https://humanmotionlib.example/schema/common.schema.json#/$defs/quaternion"
        }
      },
      "required": [
        "id",
        "position_m",
        "orientation"
      ],
      "additionalProperties": false
    },
    "landmark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1e+100,
            "maximum": 1e+100
          },
          "minItems": 3,
          "maxItems": 3
        },
        "tolerance_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "provenance": {
          "$ref": "https://humanmotionlib.example/schema/common.schema.json#/$defs/provenance"
        },
        "attachment_body": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "frame",
        "position_m",
        "tolerance_h",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}

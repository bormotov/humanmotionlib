          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/armRing"
          }
        },
        "weighting": {
          "$ref": "#/$defs/armWeighting"
        },
        "mirror_winding": {
          "const": "reverse"
        },
        "junctions": {
          "const": [
            "shoulder_torso",
            "wrist_mitten"
          ]
        },
        "material_sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/materialSection"
          }
        }
      },
      "required": [
        "id",
        "geometry",
        "source_side",
        "mirror_side",
        "mirror_plane",
        "endpoints",
        "section_axes",
        "radius_source",
        "radius_scale_source",
        "control_rings",
        "weighting",
        "mirror_winding",
        "junctions",
        "material_sections"
      ],

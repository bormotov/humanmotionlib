{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanmotionlib.example/schema/character-template.schema.json",
  "title": "HML shared procedural character-surface template",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "character-surface-template"
    },
    "id": {
      "const": "exercise-mannequin-v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "compatible_profile": {
      "const": "adult-reference-v1"
    },
    "template_revision": {
      "const": 4
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_rest_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rest_contract_structures": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "space": {
      "$ref": "#/$defs/space"
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "shoulder_join": {
      "$ref": "#/$defs/shoulderJoin"
    },
    "components": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/torso"
          },
          {
            "$ref": "#/$defs/head"
          },
          {
            "$ref": "#/$defs/arm"
          },
          {
            "$ref": "#/$defs/leg"
          },
          {
            "$ref": "#/$defs/foot"
          }
        ]
      }
    },
    "materials": {
      "$ref": "#/$defs/materials"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "description",
    "license",
    "provenance",
    "compatible_profile",
    "template_revision",
    "binding_revision",
    "expected_rest_contract_sha256",
    "rest_contract_structures",
    "space",
    "topology",
    "shoulder_join",
    "components",
    "materials",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "pair": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/positive"
        },
        {
          "$ref": "#/$defs/positive"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/nonnegative"
        },
        {
          "$ref": "#/$defs/nonnegative"
        },
        {
          "$ref": "#/$defs/nonnegative"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "authored",
            "adapted"
          ]
        },
        "license": {
          "const": "CC-BY-4.0"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              }
            },
            "required": [
              "material",
              "locator"
            ],
            "additionalProperties": false
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "license",
        "sources",
        "rationale",
        "changes"
      ],
      "additionalProperties": false
    },
    "space": {
      "type": "object",
      "properties": {
        "positions": {
          "const": "stature_normalized"
        },
        "basis": {
          "const": "right_handed_profile_space"
        },
        "rest_pose": {
          "const": "skeletal_T_pose"
        },
        "stature_source": {
          "const": "render_request"
        },
        "mirror_plane": {
          "const": "x_zero"
        }
      },
      "required": [
        "positions",
        "basis",
        "rest_pose",
        "stature_source",
        "mirror_plane"
      ],
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "loft_and_ellipsoid"
        },
        "loft_ring_vertices": {
          "const": 32
        },
        "intervals_per_control_interval": {
          "const": 4
        },
        "ring_interpolation": {
          "const": "linear"
        },
        "weight_interpolation": {
          "const": "smoothstep"
        },
        "face_diagonal": {
          "const": "lower_vertex_id"
        },
        "cap_style": {
          "const": "center_fan"
        },
        "head_longitudes": {
          "const": 32
        },
        "head_latitude_intervals": {
          "const": 16
        },
        "subdivision": {
          "const": "none"
        },
        "remesh": {
          "const": "none"
        },
        "automatic_weights": {
          "const": false
        },
        "modifiers_may_change_topology": {
          "const": false
        }
      },
      "required": [
        "kind",
        "loft_ring_vertices",
        "intervals_per_control_interval",
        "ring_interpolation",
        "weight_interpolation",
        "face_diagonal",
        "cap_style",
        "head_longitudes",
        "head_latitude_intervals",
        "subdivision",
        "remesh",
        "automatic_weights",
        "modifiers_may_change_topology"
      ],
      "additionalProperties": false
    },
    "shoulderJoin": {
      "type": "object",
      "properties": {
        "constructor": {
          "const": "welded_shoulder_bridge"
        },
        "torso_lower_rings": {
          "const": [
            24,
            31
          ]
        },
        "torso_lower_sectors_right": {
          "const": [
            28,
            29,
            30,
            31,
            0,
            1,
            2,
            3
          ]
        },
        "arm_join_ring": {
          "const": 8
        },
        "bridge_intermediate_loops": {
          "const": 3
        },
        "weight_interpolation": {
          "const": "smoothstep_3t2_minus_2t3"
        },
        "maximum_influences_bridge": {
          "const": 3
        },
        "maximum_influences_elsewhere": {
          "const": 2
        },
        "refinement_passes": {
          "const": 2
        },
        "position_rule": {
          "const": "midpoint_then_neighbor_average"
        },
        "interior_relaxation": {
          "const": 0.25
        },
        "boundary_rule": {
          "const": "fixed_conforming_midpoints"
        },
        "weight_rule": {
          "const": "construction_coordinates"
        },
        "maximum_rest_deviation_h": {
          "const": 0.005
        },
        "arms_down_profile": {
          "type": "object",
          "properties": {
            "kind": {"const": "canonical_neutral_upper_plateau_v1"},
            "support_start_z_h": {"const": 0.81},
            "support_end_z_h": {"const": 0.84},
            "plateau_end_u": {"const": 0.5},
            "maximum_rest_deviation_h": {"const": 0.02}
          },
          "required": ["kind", "support_start_z_h", "support_end_z_h", "plateau_end_u", "maximum_rest_deviation_h"],
          "additionalProperties": false
        }
      },
      "required": [
        "constructor",
        "torso_lower_rings",
        "torso_lower_sectors_right",
        "arm_join_ring",
        "bridge_intermediate_loops",
        "weight_interpolation",
        "maximum_influences_bridge",
        "maximum_influences_elsewhere",
        "refinement_passes",
        "position_rule",
        "interior_relaxation",
        "boundary_rule",
        "weight_rule",
        "maximum_rest_deviation_h",
        "arms_down_profile"
      ],
      "additionalProperties": false
    },
    "torsoRing": {
      "type": "object",
      "properties": {
        "z_h": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "radius_h": {
          "$ref": "#/$defs/pair"
        }
      },
      "required": [
        "z_h",
        "radius_h"
      ],
      "additionalProperties": false
    },
    "torsoWeighting": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "longitudinal_chain"
        },
        "carriers": {
          "const": [
            "pelvis",
            "L5",
            "L1",
            "T12",
            "T6",
            "T1",
            "C7",
            "C3",
            "C1"
          ]
        },
        "coordinate": {
          "const": "rest_carrier_origin_z"
        },
        "outside_chain": {
          "const": "clamp_to_end_carrier"
        },
        "equal_z_origins": {
          "const": "reject"
        },
        "maximum_influences": {
          "const": 2
        }
      },
      "required": [
        "kind",
        "carriers",
        "coordinate",
        "outside_chain",
        "equal_z_origins",
        "maximum_influences"
      ],
      "additionalProperties": false
    },
    "torso": {
      "type": "object",
      "properties": {
        "id": {
          "const": "torso"
        },
        "geometry": {
          "const": "loft"
        },
        "section_frame": {
          "const": "world_xy"
        },
        "control_rings": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/torsoRing"
          }
        },
        "center_h": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "weighting": {
          "$ref": "#/$defs/torsoWeighting"
        },
        "junctions": {
          "const": [
            "shoulder_torso",
            "hip_torso",
            "neck_head"
          ]
        },
        "material": {
          "const": "suit"
        }
      },
      "required": [
        "id",
        "geometry",
        "section_frame",
        "control_rings",
        "center_h",
        "weighting",
        "junctions",
        "material"
      ],
      "additionalProperties": false
    },
    "headWeighting": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rigid"
        },
        "carrier": {
          "const": "skull"
        }
      },
      "required": [
        "kind",
        "carrier"
      ],
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "properties": {
        "id": {
          "const": "head"
        },
        "geometry": {
          "const": "ellipsoid"
        },
        "center_h": {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 0.008
            },
            {
              "const": 0.9375
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "radii_source": {
          "const": "appearance.head_radii_h"
        },
        "weighting": {
          "$ref": "#/$defs/headWeighting"
        },
        "material": {
          "const": "head_mitten"
        }
      },
      "required": [
        "id",
        "geometry",
        "center_h",
        "radii_source",
        "weighting",
        "material"
      ],
      "additionalProperties": false
    },
    "armRing": {
      "type": "object",
      "properties": {
        "span": {
          "enum": [
            "shoulder_to_elbow",
            "elbow_to_wrist",
            "wrist_to_hand_tip"
          ]
        },
        "t": {
          "type": "number",
          "minimum": -0.12,
          "maximum": 1
        },
        "radius_h": {
          "$ref": "#/$defs/pair"
        }
      },
      "required": [
        "span",
        "t",
        "radius_h"
      ],
      "additionalProperties": false
    },
    "armBand": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "shoulder",
            "elbow",
            "forearm_twist",
            "wrist"
          ]
        },
        "center": {
          "enum": [
            "shoulder",
            "elbow",
            "wrist"
          ]
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "reference": {
          "enum": [
            "upper_arm_length",
            "min_adjacent_arm_length",
            "forearm_length"
          ]
        },
        "span": {
          "const": "elbow_to_wrist"
        },
        "interval": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "armWeighting": {
      "type": "object",
      "properties": {
        "maximum_influences": {
          "const": 2
        },
        "bands": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/armBand"
          }
        },
        "hand_carrier": {
          "const": "wrist.R"
        },
        "interpolation": {
          "const": "smoothstep_3t2_minus_2t3"
        },
        "unit_weight_outside_bands": {
          "const": true
        }
      },
      "required": [
        "maximum_influences",
        "bands",
        "hand_carrier",
        "interpolation",
        "unit_weight_outside_bands"
      ],
      "additionalProperties": false
    },
    "materialSection": {
      "type": "object",
      "properties": {
        "from_span": {
          "const": "wrist_to_hand_tip"
        },
        "material": {
          "const": "head_mitten"
        },
        "other": {
          "const": "suit"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "from_span",
            "material"
          ]
        },
        {
          "required": [
            "other"
          ]
        }
      ]
    },
    "arm": {
      "type": "object",
      "properties": {
        "id": {
          "const": "arm.R"
        },
        "geometry": {
          "const": "mirrored_loft"
        },
        "source_side": {
          "const": "R"
        },
        "mirror_side": {
          "const": "L"
        },
        "mirror_plane": {
          "const": "x_zero"
        },
        "endpoints": {
          "type": "object",
          "properties": {
            "shoulder": {
              "const": "shoulder.R"
            },
            "elbow": {
              "const": "elbow.R.origin"
            },
            "wrist": {
              "const": "wrist.R.origin"
            },
            "hand_tip": {
              "const": "wrist_plus_forearm_direction"
            },
            "hand_tip_distance_h": {

{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "body-groups"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "provenance": {
      "$ref": "https://humanmotionlib.example/schema/common.schema.json#/$defs/provenance"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "pelvis",
              "torso",
              "head_neck",
              "arm_L",
              "arm_R",
              "leg_L",
              "leg_R"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "description",
          "channels"
        ],
        "additionalProperties": false
      },
      "minItems": 7
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "description",
    "license",
    "provenance",
    "groups"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanmotionlib.example/schema/body-groups.schema.json"
}

{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "humanoid-map"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "provenance": {
      "$ref": "https://humanmotionlib.example/schema/common.schema.json#/$defs/provenance"
    },
    "semantic_version": {
      "const": "VRMC_vrm-1.0"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "humanoid": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "pelvis",
              "torso",
              "head_neck",
              "arm_L",
              "arm_R",
              "leg_L",
              "leg_R"
            ]
          }
        },
        "required": [
          "humanoid",
          "target",
          "group"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "humanoid": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "humanoid",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "internal_only": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "description",
    "license",
    "provenance",
    "semantic_version",
    "profile",
    "required",
    "entries",
    "omissions",
    "losses",
    "internal_only"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanmotionlib.example/schema/humanoid-map.schema.json"
}
